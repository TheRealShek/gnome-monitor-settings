[Unit]
Description=External monitor settings service
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=dbus
BusName=io.github.avifenesh.GnomeMonitorSettings.Service
ExecStart=/usr/bin/gnome-monitor-settings-service
Restart=on-failure
RestartSec=2s
TimeoutStopSec=5s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictSUIDSGID=true
LockPersonality=true
